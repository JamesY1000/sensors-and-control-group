<mujoco model="TurtleBot3 practice room">
  <include file="../robot_model/turtlebot3_waffle/turtlebot3_waffle_pi.xml"/>
  <!-- Resolve the robot meshes when this scene is loaded from world/. -->
  <compiler meshdir="../robot_model/turtlebot3_waffle/assets/" texturedir="assets/"/>

  <statistic center="3 0 0.3" extent="5.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-55"/>
  </visual>

  <asset>
    <!-- Attach keeps the station's mesh and texture paths local to its XML. -->
    <model name="dock_model" file="charging_station.xml"/>
    <model name="table_model" file="furniture/table.xml"/>
    <model name="chair_model" file="furniture/chair.xml"/>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <attach model="dock_model" body="charging_station" prefix=""/>
    <light pos="3 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Interior: 8 m along X (-1 to 7), 6 m along Y (-3 to 3).
         The Python launcher applies robot/dock spawns from config/scene.toml.
         All room geoms are fixed.
         Box size values are HALF the full dimensions, in metres. -->
    <geom name="wall_west" type="box" pos="-1.05 0 0.4" size="0.05 3 0.4"
      rgba="0.72 0.75 0.8 1"/>
    <geom name="wall_east" type="box" pos="7.05 0 0.4" size="0.05 3 0.4"
      rgba="0.72 0.75 0.8 1"/>
    <geom name="wall_north" type="box" pos="3 3.05 0.4" size="4.1 0.05 0.4"
      rgba="0.72 0.75 0.8 1"/>
    <geom name="wall_south" type="box" pos="3 -3.05 0.4" size="4.1 0.05 0.4"
      rgba="0.72 0.75 0.8 1"/>

    <!-- Fixed furniture with individual collision legs, not solid bounding boxes.
         The 0.126 m LiDAR scan sees the legs; tabletops and seats stay above it.
         Two staggered seating areas leave a clear central approach to the dock.
         Edit frame positions here to rearrange furniture; dimensions/materials
         live in furniture/table.xml and furniture/chair.xml. -->
    <frame name="table_a_placement" pos="2 1.55 0">
      <attach model="table_model" body="table" prefix="table_a_"/>
    </frame>
    <frame name="chair_a_near_placement" pos="2 1.30 0" quat="0.7071067812 0 0 0.7071067812">
      <attach model="chair_model" body="chair" prefix="chair_a_near_"/>
    </frame>
    <frame name="chair_a_far_placement" pos="2 1.80 0" quat="0.7071067812 0 0 -0.7071067812">
      <attach model="chair_model" body="chair" prefix="chair_a_far_"/>
    </frame>

    <frame name="table_b_placement" pos="4.5 -1.55 0">
      <attach model="table_model" body="table" prefix="table_b_"/>
    </frame>
    <frame name="chair_b_near_placement" pos="4.5 -1.30 0" quat="0.7071067812 0 0 -0.7071067812">
      <attach model="chair_model" body="chair" prefix="chair_b_near_"/>
    </frame>
    <frame name="chair_b_far_placement" pos="4.5 -1.80 0" quat="0.7071067812 0 0 0.7071067812">
      <attach model="chair_model" body="chair" prefix="chair_b_far_"/>
    </frame>

  </worldbody>
</mujoco>
