<mujoco model="Create 3 charging station with ArUco panel">
  <compiler angle="radian" meshdir="assets/create3_dock/" texturedir="assets/"/>
  <asset>
    <mesh name="create3_dock_black" file="dock_black.obj"/>
    <mesh name="create3_dock_white" file="dock_white.obj"/>
    <material name="create3_dock_black" rgba="0.12 0.13 0.15 1" specular="0.25" shininess="0.25"/>
    <material name="create3_dock_white" rgba="0.85 0.85 0.85 1" specular="0.25" shininess="0.25"/>

    <!-- DICT_4X4_50, ID 0: 0.20 m black marker, 0.04 m white margin per side. -->
    <texture name="aruco_0" type="2d" file="marker_0.png"/>
    <material name="aruco_0" texture="aruco_0" specular="0" shininess="0" reflectance="0"/>
    <!-- ID 1: 0.04 m black square in a 0.06 m panel, 0.01 m margins.
         Texture is 400 black pixels inside 600 total pixels: exact 2/3 ratio. -->
    <texture name="aruco_1" type="2d" file="marker_1.png"/>
    <material name="aruco_1" texture="aruco_1" specular="0" shininess="0" reflectance="0"/>
  </asset>

  <worldbody>
    <!-- Local +X points out of the dock toward the approaching robot; +Z is up.
         The station origin is at ground height. The default faces world -X.
         config/simulation_config.yml moves this fixed body, carrying dock and panel together. -->
    <body name="charging_station" pos="6.9 0 0" quat="0 0 0 1">
      <!-- Original iRobot visual geometry, at its original scale (metres).
           Preserve the upstream URDF's 4.6 mm visual origin offset. -->
      <geom name="create3_dock_shell" type="mesh" mesh="create3_dock_black"
        pos="0 0 0.0046" material="create3_dock_black"
        contype="0" conaffinity="0" density="0" group="2"/>
      <geom name="create3_dock_details" type="mesh" mesh="create3_dock_white"
        pos="0 0 0.0046" material="create3_dock_white"
        contype="0" conaffinity="0" density="0" group="2"/>
      <!-- Upstream's simple housing collision, not the visual mesh convex hull:
           leaves the approach area in front of the housing unobstructed. -->
      <geom name="create3_dock_collision" type="box" pos="-0.045 0 0.05"
        size="0.02 0.065 0.05" rgba="0 0 0 0" group="3"/>

      <!-- A narrow post and rigid backing hold the marker above the dock.
           Panel bottom is z=0.12 m, above the housing top (~0.102 m). -->
      <geom name="station_panel_post" type="box" pos="-0.061 0 0.11"
        size="0.008 0.009 0.11" rgba="0.20 0.22 0.25 1"/>
      <geom name="station_back" type="box" pos="-0.056 0 0.26"
        size="0.004 0.144 0.144" rgba="0.20 0.22 0.25 1"/>
      <!-- The texture is oriented correctly on the +X face. Its white border
           is included in the 0.28 m panel; keep it around the 0.20 m marker. -->
      <geom name="station_marker_panel" type="box" pos="-0.051 0 0.26"
        size="0.001 0.14 0.14" material="aruco_0"
        contype="0" conaffinity="0" density="0" group="2"/>
      <!-- Exact visible marker-face centre and OpenCV ArUco axes:
           x right in a front view (+Y), y up (+Z), z out of the panel (+X).
           This ground-truth site is hidden from the robot camera. -->
      <site name="aruco_marker_0" pos="-0.05 0 0.26"
        xyaxes="0 1 0 0 0 1" size="0.01" rgba="1 0 1 1" group="5"/>

      <!-- Close-range marker remains visible after the large panel leaves the
           low camera image. Both IDs localise the robot against the configured dock.
           Local +X face is exactly x=-0.025; site and texture share that plane.
           Like the large marker, this thin panel is a visual sensor target. -->
      <geom name="station_near_marker_panel" type="box" pos="-0.026 0 0.12"
        size="0.001 0.03 0.03" material="aruco_1"
        contype="0" conaffinity="0" density="0" group="2"/>
      <site name="aruco_marker_1" pos="-0.025 0 0.12"
        xyaxes="0 1 0 0 0 1" size="0.003" rgba="0 1 1 1" group="5"/>
    </body>
  </worldbody>
</mujoco>
